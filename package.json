{
	"name": "vivi-figma-mcp",
	"version": "0.8.2",
	"description": "MCP-сервер и плагин Figma: чтение и редактирование дизайна, экспорт ассетов, перенос HTML и динамических сайтов в редактируемые слои с поддержкой мобильных экранов.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"mcp",
		"figma",
		"model-context-protocol",
		"design",
		"figma-plugin",
		"design-generation"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Razavik/Vivi-Figma.git"
	},
	"homepage": "https://github.com/Razavik/Vivi-Figma#readme",
	"bin": {
		"vivi-figma-mcp": "server/cli.mjs"
	},
	"files": [
		"server/*.mjs",
		"server/package.json",
		"server/.env.example",
		"server/design-guide",
		"server/icons",
		"plugin/manifest.json",
		"plugin/dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"setup": "npm install && npm --prefix plugin install && npm --prefix plugin run build",
		"build": "npm --prefix plugin run build",
		"start": "node server/index.mjs",
		"typecheck": "npm --prefix plugin run typecheck",
		"test": "npm --prefix server test && npm --prefix plugin test",
		"test:server": "npm --prefix server test",
		"test:plugin": "npm --prefix plugin test",
		"prepublishOnly": "node scripts/build-icons.mjs && npm --prefix plugin install && npm --prefix plugin run build && npm test && node scripts/smoke.mjs",
		"build:icons": "node scripts/build-icons.mjs",
		"setup:browser": "playwright install chromium",
		"smoke": "node scripts/smoke.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"playwright": "^1.65.1",
		"qrcode": "^1.5.4",
		"ws": "^8.18.0",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"lucide-static": "^1.61.0",
		"pngjs": "^5.0.0"
	}
}
