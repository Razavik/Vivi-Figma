{
	"name": "vivi-figma-mcp",
	"version": "0.4.1",
	"description": "MCP-сервер: ИИ-агенты (Claude Code, Cursor, Devin…) смотрят дизайн в открытом файле Figma, выгружают из него картинки и создают/правят дизайн настоящими нодами.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"mcp",
		"figma",
		"model-context-protocol",
		"design",
		"figma-plugin",
		"design-generation"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Razavik/Vivi-Figma.git"
	},
	"homepage": "https://github.com/Razavik/Vivi-Figma#readme",
	"bin": {
		"vivi-figma-mcp": "server/cli.mjs"
	},
	"files": [
		"server/*.mjs",
		"server/package.json",
		"server/.env.example",
		"server/design-guide",
		"server/icons",
		"plugin/manifest.json",
		"plugin/dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"setup": "npm install && npm --prefix plugin install && npm --prefix plugin run build",
		"build": "npm --prefix plugin run build",
		"start": "node server/index.mjs",
		"typecheck": "npm --prefix plugin run typecheck",
		"prepublishOnly": "node scripts/build-icons.mjs && npm --prefix plugin install && npm --prefix plugin run build",
		"build:icons": "node scripts/build-icons.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"qrcode": "^1.5.4",
		"ws": "^8.18.0",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"lucide-static": "^1.61.0"
	}
}
