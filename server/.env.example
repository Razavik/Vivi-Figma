# Скопируйте в .env — сервер подхватит переменные при старте.
# Настоящие ключи храните только в .env, сюда вставлять НЕ надо.
# Claude через прокси:
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Devin: либо этот ключ, либо credentials.toml профиля Devin Desktop.
WINDSURF_API_KEY=
# Стоковые фото для image-нод (необязательно): с ключом берётся Pexels,
# затем Unsplash, затем Pixabay; без ключей — LoremFlickr/Picsum
# (без регистрации). Ключи бесплатные на сайтах сервисов.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
# Путь к ACP-мосту Claude и к devin.exe при необходимости:
# CLAUDE_ACP_BRIDGE=D:/Work/Learning/FigmaAgent/server/bridges/claude/index.mjs
# DEVIN_CLI=D:/Programs/Devin/resources/app/extensions/windsurf/devin/bin/devin.exe
# PORT=8787
# Необязательный токен для подключения плагина к мосту:
# BRIDGE_TOKEN=

# Настоящие карты OpenStreetMap для блока map ("real":true): 1 — включить. Внешняя сеть, геокодер Nominatim и тайлы OSM; кэш включён, подпись © OpenStreetMap contributors ставится на карту.
OSM_MAPS=

# MCP: картинки из Figma пишутся только внутри проекта агента (его рабочая папка;
# можно задать явно MCP_PROJECT_DIR). Дополнительные разрешённые папки — абсолютные пути через ;
# MCP_PROJECT_DIR=
# MCP_EXPORT_ROOTS=
