# Vivi MCP: все переменные необязательны. Скопируйте в .env и раскомментируйте нужное.

# Порт моста (плагин и MCP-сервер должны использовать один и тот же)
# PORT=8787

# Картинки из Figma пишутся только внутри проекта агента (его рабочая папка;
# можно задать явно MCP_PROJECT_DIR). Дополнительные разрешённые папки —
# абсолютные пути через ;
# MCP_PROJECT_DIR=
# MCP_EXPORT_ROOTS=

# 1 — MCP-сервер не запускает мост сам, если тот не работает
# MCP_NO_AUTOSTART=

# Через сколько минут без клиентов мост завершается сам (0 — никогда)
# IDLE_EXIT_MIN=15
